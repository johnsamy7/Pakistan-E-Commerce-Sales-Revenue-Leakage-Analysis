   "source": "# -*- coding: utf-8 -*-\n\"\"\"E-commerce .ipynb\n\nAutomatically generated by Colab.\n\nOriginal file is located at\n    https://colab.research.google.com/drive/1JjupYPj0LZxjeRLvYBEh_0CqeGfeXRo7\n\"\"\"\n\nimport pandas as pd\nimport numpy as np\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nimport plotly.express as px\n\ndf = pd.read_csv(\"/content/Pakistan Largest Ecommerce Dataset.csv\")\n\ndf\n\ndf = df.loc[:, ~df.columns.str.contains('^Unnamed')]\ndf\n\ndf = df.dropna(how='all')\ndf\n\ndf.info()\n\ndf.isnull().sum()\n\ndf = df.drop('sales_commission_code', axis=1)\n\ndf.dropna(inplace=True)\ndf.reset_index(drop=True, inplace=True)\n\ndf.isnull().sum()\n\ndf.duplicated().sum()\n\ndf = df.replace(r'^\\s*\\\\N\\s*$', np.nan, regex=True)\ndf.isnull().sum()\n\ndf['category_name_1'] = df['category_name_1'].fillna('Others')\ndf = df.dropna(subset=['status'])\n\ndf.isnull().sum()\n\ndf.duplicated().sum()\n\ndf.info()\n\ndf['created_at'] = pd.to_datetime(df['created_at'], errors='coerce')\ndf['Working Date'] = pd.to_datetime(df['Working Date'], errors='coerce')\ndf['Customer Since'] = pd.to_datetime(df['Customer Since'], format='%Y-%m', errors='coerce')\n\ndf['M-Y'] = df['M-Y'].astype(str).str.strip()\n\ndf['increment_id'] = pd.to_numeric(df['increment_id'], errors='coerce').astype('Int64')\ndf['Customer ID'] = pd.to_numeric(df['Customer ID'], errors='coerce').astype('Int64')\ndf['item_id'] = pd.to_numeric(df['item_id'], errors='coerce').astype('Int64')\n\ndf.columns = df.columns.str.strip()\n\ndf['MV'] = df['MV'].dropna().astype(str).str.replace(r'[^0-9.]', '', regex=True)\ndf['MV'] = pd.to_numeric(df['MV'], errors='coerce')\n\ndf['Year'] = pd.to_numeric(df['Year'], errors='coerce').astype('Int64')\ndf['Month'] = pd.to_numeric(df['Month'], errors='coerce').astype('Int64')\ndf['qty_ordered'] = pd.to_numeric(df['qty_ordered'], errors='coerce').astype('Int64')\n\ndf.info()\n\ndf.isnull().sum()\n\ndf['MV'] = df['MV'].fillna(df['MV'].median())\n\ndf.dropna(inplace=True)\ndf.reset_index(drop=True, inplace=True)\n\ndf.isnull().sum()\n\ndf\n\nnumeric_cols = ['price', 'qty_ordered', 'grand_total', 'discount_amount', 'MV']\n\noutlier_summary = []\nfor col in numeric_cols:\n    Q1 = df[col].quantile(0.25)\n    Q3 = df[col].quantile(0.75)\n    IQR = Q3 - Q1\n\n    lower = Q1 - 1.5 * IQR\n    upper = Q3 + 1.5 * IQR\n\n    count = ((df[col] < lower) | (df[col] > upper)).sum()\n    pct = (count / len(df)) * 100\n\n    outlier_summary.append({\n        'Metric': col,\n        'Min': df[col].min(),\n        'Max': df[col].max(),\n        'Lower Bound': round(lower, 2),\n        'Upper Bound': round(upper, 2),\n        'Outliers Count': count,\n        'Outliers %': round(pct, 2)\n    })\n\noutlier_df = pd.DataFrame(outlier_summary)\nprint(outlier_df.to_string(index=False))\n\nnegative_grand_total_count = (df['grand_total'] < 0).sum()\nnegative_discount_amount = (df['discount_amount'] < 0).sum()\nprices_equal_to_zero = (df['price'] == 0).sum()\nprint(f"Number of negative values in 'grand_total': {negative_grand_total_count}")\nprint(f"Number of negative values in 'discount_amount': {negative_discount_amount}")\nprint(f"number of zeros in 'price': {prices_equal_to_zero}")\n\n# Remove zero prices and negative grand totals and discounts\ndf = df[(df['price'] > 0) & (df['grand_total'] >= 0) & (df['discount_amount'] >= 0)]\ndf.reset_index(drop=True, inplace=True)\n\ndf.info()\n\ndf\n\nextreme_orders = df[df['grand_total'] > 1000000]\nprint(f"Orders > 1,000,000: {len(extreme_orders)}")\n\nprint(df['grand_total'].nlargest(30).to_string())\n\ndf = df[df['grand_total'] != 17888000.0]\n\nprint(df['price'].nlargest(30).to_string())\n\nprint(df['MV'].nlargest(30).to_string())\n\noutlier_summary = []\nfor col in numeric_cols:\n    Q1 = df[col].quantile(0.25)\n    Q3 = df[col].quantile(0.75)\n    IQR = Q3 - Q1\n\n    lower = Q1 - 1.5 * IQR\n    upper = Q3 + 1.5 * IQR\n\n    count = ((df[col] < lower) | (df[col] > upper)).sum()\n    pct = (count / len(df)) * 100\n\n    outlier_summary.append({\n        'Metric': col,\n        'Min': df[col].min(),\n        'Max': df[col].max(),\n        'Lower Bound': round(lower, 2),\n        'Upper Bound': round(upper, 2),\n        'Outliers Count': count,\n        'Outliers %': round(pct, 2)\n    })\n\noutlier_df = pd.DataFrame(outlier_summary)\nprint(outlier_df.to_string(index=False))\n\n#detect duplicate in names\n\ntext_cols = ['status', 'payment_method', 'category_name_1', 'BI Status']\n\n#remove any spaces for a clean name\nfor col in text_cols:\n    df[col] = df[col].astype(str).str.strip()\n\nfor col in text_cols:\n    print(f"\n--- Unique values in {col} ---")\n    print(df[col].unique())\n\nref_count = (df['BI Status'] == '#REF!').sum()\nprint(f"Rows with #REF! in BI Status: {ref_count}")\n\nprint(df[df['BI Status'] == '#REF!'][['status', 'grand_total', 'BI Status']].head())\n\n# Standardize payment_method to lowercase\ndf['payment_method'] = df['payment_method'].str.lower()\n\n# 1. Lowercase payment methods to standardize names\ndf['payment_method'] = df['payment_method'].str.lower()\n\n# 2. Map or replace '#REF!' in BI Status (Replacing with 'Unknown' or mapping based on status)\ndf['BI Status'] = df['BI Status'].replace('#REF!', 'Unknown')\n\n# Confirm updated unique values\nprint("--- Cleaned BI Status ---")\nprint(df['BI Status'].unique())\n\nprint("\n--- Cleaned Payment Methods ---")\nprint(df['payment_method'].unique())\n\n# exact duplicate rows across all columns\nexact_dupes = df.duplicated().sum()\nprint(f"Exact duplicate rows: {exact_dupes}")\n\n# Remove exact duplicates\nif exact_dupes > 0:\n    df = df.drop_duplicates()\n\n# duplicate order items (Same order ID + Same Item ID)\nitem_dupes = df.duplicated(subset=['increment_id', 'item_id']).sum()\nprint(f"Duplicate item entries within same order: {item_dupes}")\n\ndf.to_csv('cleaned_ecommerce_data.csv', index=False)\n\ndf.head(30)\n\nplt.figure(figsize=(12, 6))\nmonthly_rev = df.groupby(['Year', 'Month'])['grand_total'].sum().reset_index()\nmonthly_rev['Date'] = pd.to_datetime(monthly_rev[['Year', 'Month']].assign(DAY=1))\n\nsns.lineplot(data=monthly_rev, x='Date', y='grand_total', marker='o', linewidth=2, color='b')\nplt.title('Monthly Realized Revenue Trajectory', fontsize=14, fontweight='bold')\nplt.ylabel('Total Revenue')\nplt.xlabel('Month')\nplt.xticks(rotation=45)\nplt.grid(True)\nplt.tight_layout()\nplt.show()\n\nplt.figure(figsize=(12, 8))\ncat_rev = df.groupby('category_name_1')['grand_total'].sum().sort_values(ascending=False).head(10)\nsns.barplot(x=cat_rev.values, y=cat_rev.index, palette=\"viridis\")\nplt.title('Top 10 Categories by Realized Revenue', fontsize=14, fontweight='bold')\nplt.xlabel('Total Revenue')\nplt.ylabel('Product Category')\nplt.grid(True)\nplt.tight_layout()\nplt.show()\n\nplt.figure(figsize=(12, 8))\naov_cat = df.groupby('category_name_1')['grand_total'].mean().sort_values(ascending=False).head(10)\nsns.barplot(x=aov_cat.values, y=aov_cat.index, hue=aov_cat.index, palette=\"mako\", legend=False)\nplt.title(' Average Order Value (AOV) by Category', fontsize=14, fontweight='bold')\nplt.xlabel('Average Spend per Order')\nplt.ylabel('Product Category')\nplt.grid(True)\nplt.tight_layout()\nplt.show()\n\nplt.figure(figsize=(12, 8))\ntop_skus = df.groupby('sku')['qty_ordered'].sum().sort_values(ascending=False).head(10)\nsns.barplot(x=top_skus.values, y=top_skus.index, hue=top_skus.index, palette=\"rocket\", legend=False)\nplt.title('Top 10 Highest Volume Products (Inventory Focus)', fontsize=14, fontweight='bold')\nplt.xlabel('Total Quantity Sold')\nplt.ylabel('SKU')\nplt.grid(True)\nplt.tight_layout()\nplt.show()\n\nplt.figure(figsize=(12, 8))\nstatus_counts = df['status'].value_counts().head(8)\nsns.barplot(x=status_counts.values, y=status_counts.index, hue=status_counts.index, palette=\"Reds_r\", legend=False)\nplt.title('Order Status Breakdown (Fulfillment Health)', fontsize=14, fontweight='bold')\nplt.xlabel('Number of Orders')\nplt.ylabel('Status')\nplt.grid(True)\nplt.tight_layout()\nplt.show()\n\nplt.figure(figsize=(12, 8))\npayment_counts = df['payment_method'].value_counts().head(10)\nsns.barplot(x=payment_counts.values, y=payment_counts.index, hue=payment_counts.index, palette=\"crest\", legend=False)\nplt.title('Most Popular Payment Methods', fontsize=14, fontweight='bold')\nplt.xlabel('Number of Transactions')\nplt.ylabel('Payment Method')\nplt.grid(True)\nplt.tight_layout()\nplt.show()\n\npayment_risk = df.groupby('payment_method').agg(\n    Total_Orders=('increment_id', 'nunique'),\n    Canceled_Orders=('status', lambda x: (x == 'canceled').sum())\n)\npayment_risk = payment_risk[payment_risk['Total_Orders'] > 1000].reset_index()\npayment_risk['Cancel_Rate_%'] = (payment_risk['Canceled_Orders'] / payment_risk['Total_Orders']) * 100\npayment_risk = payment_risk.sort_values('Cancel_Rate_%', ascending=False)\n\nfig3 = px.bar(payment_risk, x='Cancel_Rate_%', y='payment_method', orientation='h',\n              title='Cancellation Risk by Payment Method (High = Bad)',\n              labels={'Cancel_Rate_%': 'Cancellation Rate (%)', 'payment_method': 'Payment Method'},\n              color='Cancel_Rate_%', color_continuous_scale='Reds')\nfig3.update_layout(yaxis={'categoryorder':'total ascending'})\nfig3.show()\n\ndf['DayOfWeek'] = df['created_at'].dt.day_name()\ndays_order = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday']\ndaily_traffic = df.groupby('DayOfWeek')['increment_id'].nunique().reindex(days_order).reset_index()\n\nfig4 = px.bar(daily_traffic, x='DayOfWeek', y='increment_id',\n              title='Peak Shopping Days (Optimize Ad Spend)',\n              labels={'increment_id': 'Total Unique Orders', 'DayOfWeek': 'Day of the Week'},\n              color='increment_id', color_continuous_scale='Blues')\nfig4.show()\n\ndf.groupby('category_name_1').agg(\n    Revenue=('grand_total', 'sum'),\n    Discounts=('discount_amount', 'sum'))\n\ndiscount_impact = df.groupby('category_name_1').agg(\n    Revenue=('grand_total', 'sum'),\n    Discounts=('discount_amount', 'sum')\n).sort_values('Revenue', ascending=False).head(10).reset_index()\n\nfig5 = px.bar(discount_impact, x='category_name_1', y=['Revenue', 'Discounts'], barmode='group',\n              title=' Revenue vs. Discount Expenditure by Category',\n              labels={'value': 'Monetary Value', 'category_name_1': 'Category', 'variable': 'Metric'},\n              color_discrete_map={'Revenue': '#2CA02C', 'Discounts': '#D62728'})\nfig5.show()\n\ndf['First_Purchase_Date'] = df.groupby('Customer ID')['created_at'].transform('min')\ndf['Customer_Type'] = np.where(df['created_at'] == df['First_Purchase_Date'], 'New', 'Returning')\n\nretention_rev = df.groupby(['Year', 'Month', 'Customer_Type'])['grand_total'].sum().reset_index()\nretention_rev['Date'] = pd.to_datetime(retention_rev[['Year', 'Month']].assign(DAY=1))\n\nfig3 = px.area(retention_rev, x='Date', y='grand_total', color='Customer_Type',\n               title='Revenue from New vs Returning Customers (Area Chart)',\n               labels={'grand_total': 'Total Revenue', 'Date': 'Timeline'},\n               color_discrete_map={'New': '#1f77b4', 'Returning': '#2ca02c'})\nfig3.show()\n\ndf['Price_Tier'] = pd.qcut(df['price'], q=4, labels=['Low', 'Medium-Low', 'Medium-High', 'Premium'])\ntier_rev = df.groupby('Price_Tier', observed=False)['grand_total'].sum().reset_index()\n\nfig5 = px.pie(tier_rev, values='grand_total', names='Price_Tier', hole=0.4,\n              title='Revenue Distribution by Price Tier (Donut Chart)',\n              color_discrete_sequence=px.colors.sequential.Plasma)\nfig5.show()\n\ndf_sales = df[df['status'].isin(['complete', 'received', 'closed'])].copy()\n\n\ntop_statuses = df['status'].value_counts().nlargest(5).reset_index()\ntop_statuses.columns = ['Order Status', 'Total Orders']\n\nfig1 = px.funnel(top_statuses, x='Total Orders', y='Order Status',\n                 title='Order Fulfillment Survival Rate',\n                 color_discrete_sequence=['#1f77b4'])\nfig1.show()\n\nbubble_data = df_sales.groupby('category_name_1').agg(\n    Total_Orders=('increment_id', 'nunique'),\n    Total_Revenue=('grand_total', 'sum'),\n    AOV=('grand_total', 'mean')\n).reset_index()\n\nfig2 = px.scatter(bubble_data, x='Total_Orders', y='Total_Revenue',\n                  size='AOV', color='category_name_1', hover_name='category_name_1',\n                  title=' Category Performance Matrix (Volume vs Revenue vs AOV)',\n                  labels={'Total_Orders': 'Number of Orders Sold', 'Total_Revenue': 'Total Cash Generated'},\n                  size_max=50)\nfig2.show()\n\ntop_5_cats = df_sales['category_name_1'].value_counts().nlargest(5).index\nbox_data = df_sales[df_sales['category_name_1'].isin(top_5_cats)]\n\nfig3 = px.box(box_data, x='category_name_1', y='grand_total', color='category_name_1',\n              title='Expected Order Value Range by Top Categories',\n              labels={'category_name_1': 'Category', 'grand_total': 'Order Total'},\n              points="outliers")\nfig3.update_yaxes(range=[0, box_data['grand_total'].quantile(0.95)])\nfig3.show()\n\ndaily_revenue = df_sales.groupby(df_sales['created_at'].dt.date)['grand_total'].sum().reset_index()\ndaily_revenue['Cumulative_Revenue'] = daily_revenue['grand_total'].cumsum()\n\nfig5 = px.line(daily_revenue, x='created_at', y='Cumulative_Revenue',\n               title='Cumulative Business Revenue Growth Over Time',\n               labels={'created_at': 'Date', 'Cumulative_Revenue': 'Total Accumulated Revenue'},\n               color_discrete_sequence=['#2ca02c'])\nfig5.update_traces(line=dict(width=3))\nfig5.show()\n\ndf.info()\n"
  }
